<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Dev/test example: the App Sandbox is intentionally not enabled. The SDK
	  needs raw outbound network (QUIC to the exit), and Mode B connects to the
	  privileged warrend daemon over a Unix socket in /tmp, which a sandboxed app
	  cannot reach. flutter_secure_storage uses the login keychain. Re-enable the
	  sandbox (with network.client + keychain-sharing) for a real shipped app.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
