<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Dev/test build: App Sandbox is off so Mode B can reach the warrend daemon's
	  /tmp socket and the engine has raw network. flutter_secure_storage uses the
	  legacy login keychain (see secure_store.dart), which works here but prompts
	  once for access ("Always Allow"). A signed, sandboxed build with the
	  Keychain Sharing capability is prompt-free.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
