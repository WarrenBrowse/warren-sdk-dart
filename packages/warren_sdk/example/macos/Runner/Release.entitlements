<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Dev/test example: App Sandbox intentionally not enabled (see
	  DebugProfile.entitlements for the rationale). Re-enable it for a real app.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
